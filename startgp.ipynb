   ],
   "source": [
    "def root_s(n):\n",
    "    if n == 1:\n",
    "        return 0\n",
    "    total = 1\n",
    "\n",
    "    for d in range(2, math.isqrt(n) + 1):\n",
    "        if n % d == 0:\n",
    "            total += d\n",
    "            e = n / d\n",
    "            if e != d:\n",
    "                total += e\n",
    "    return total\n",
    "\n",
    "root_s(100)"
   ]
  },
